# Copy to .env for local development. Never commit real secrets.
DJANGO_SETTINGS_MODULE=sequencer.settings.local
SECRET_KEY=replace-with-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://sequencer:sequencer@localhost:5432/sequencer

# Comma-separated origins including scheme, required when the app is served over HTTPS.
CSRF_TRUSTED_ORIGINS=

# Production only. Render sets RENDER_EXTERNAL_URL automatically.
# SECURE_SSL_REDIRECT=true

# Optional bootstrap superuser.
# Locally this is read by createsuperuser --noinput.
# On Render Free, start.sh creates the user once. The password is not reset on later boots.
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
